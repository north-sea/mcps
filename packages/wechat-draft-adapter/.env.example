# WeChat Draft Adapter - Environment Variables Template
#
# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Fill in the values below
# 3. Secure the file: chmod 600 .env
#
# IMPORTANT: Never commit .env to git!

# Adapter Server Configuration
PORT=3000

# Authentication Token (generate with: openssl rand -base64 32)
# This token must match the WECHAT_ADAPTER_AUTH_TOKEN on NAS/client side
ADAPTER_AUTH_TOKEN=

# Allowed Accounts (comma-separated)
ALLOWED_ACCOUNTS=weiyuchengchun

# WeChat Credentials for 'weiyuchengchun' account
# Get from: WeChat MP Backend -> Settings -> Basic Config
WECHAT_APPID_WEIYUCHENGCHUN=
WECHAT_APPSECRET_WEIYUCHENGCHUN=

# Optional: Add more accounts
# WECHAT_APPID_<ACCOUNT>=
# WECHAT_APPSECRET_<ACCOUNT>=
