# WeChat Draft MCP Environment Configuration for NAS
# Copy this file to NAS and adjust paths

# ============================================================================
# Hermes-db MCP Connection
# ============================================================================

# Hermes-db MCP HTTP endpoint
HERMES_DB_BASE_URL=http://hermes-db-mcp:8080

# Auth token for hermes-db MCP
HERMES_DB_AUTH_TOKEN=YOUR_HERMES_DB_TOKEN_HERE

# ============================================================================
# WeChat Adapter Connection
# ============================================================================

# ECS adapter base URL (reachable from the Docker network or via Tailscale)
WECHAT_ADAPTER_BASE_URL=http://wechat-draft-adapter:3000

# Adapter authentication token
# 与 ECS 上运行的 adapter 的 ADAPTER_AUTH_TOKEN 保持一致
WECHAT_ADAPTER_AUTH_TOKEN=YOUR_WECHAT_ADAPTER_TOKEN_HERE

# ============================================================================
# Runtime Configuration
# ============================================================================

# Bearer token required by POST /mcp. Empty value disables MCP auth.
WECHAT_DRAFT_AUTH_TOKEN=YOUR_WECHAT_DRAFT_MCP_TOKEN_HERE

# Host port binding for the HTTP MCP service. Use 3012 for NAS runner smoke.
WECHAT_DRAFT_HTTP_BIND=3012

# Runtime path for job store inside the container
WECHAT_DRAFT_RUNTIME_PATH=/app/data
DATABASE_PATH=/app/data/jobs.db
ASSET_ROOT=/app/data/assets
