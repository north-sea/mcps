# WeChat Draft MCP Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# Hermes-db MCP Connection
# ============================================================================

# Hermes-db MCP HTTP endpoint (FastAPI server)
HERMES_DB_BASE_URL=http://nas.local:8765

# Optional: Auth token for hermes-db MCP (if authentication is enabled)
# HERMES_DB_AUTH_TOKEN=your_hermes_db_token_here

# Optional: Timeout for hermes-db requests (milliseconds, default: 10000)
# HERMES_DB_TIMEOUT_MS=10000

# ============================================================================
# WeChat Adapter Connection
# ============================================================================

# ECS adapter base URL (deployed on Ali ECS, accessible via Tailscale)
WECHAT_ADAPTER_BASE_URL=http://100.117.14.128:3000

# Adapter authentication token
# WECHAT_ADAPTER_AUTH_TOKEN=your_adapter_token_here

# Optional: ECS egress IP (for reference, not used in runtime)
# WECHAT_ECS_EGRESS_IP=<your_ecs_public_ip>

# Optional: Network path type (tailscale/wireguard/ssh_tunnel/other, default: tailscale)
# WECHAT_ADAPTER_NETWORK_PATH=tailscale

# ============================================================================
# Runtime Configuration
# ============================================================================

# Runtime path for job store (JSONL logs, default: OS temp directory)
# WECHAT_DRAFT_RUNTIME_PATH=/tmp/wechat-draft

# ============================================================================
# Security Notes
# ============================================================================
# - Never commit .env to git
# - Keep auth tokens secure
# - Rotate tokens periodically
# - Use different tokens for dev/prod environments
