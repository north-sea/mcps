{
  "name": "@mcps/wechat-draft",
  "version": "0.2.3",
  "type": "module",
  "bin": {
    "wechat-draft": "dist/index.js"
  },
  "scripts": {
    "dev": "pnpm run watch",
    "build": "tsc && shx chmod +x dist/index.js dist/http-index.js",
    "watch": "tsc --watch",
    "start": "node ./dist/index.js",
    "start:http": "node ./dist/http-index.js",
    "docker:build": "docker build -f Dockerfile -t wechat-draft-mcp:local ../..",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "",
  "license": "MIT",
  "description": "WeChat Draft MCP Server - Create WeChat drafts from hermes-db artifacts via ECS adapter",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prosemirror-model": "^1.25.9",
    "yaml": "^2.7.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.1",
    "@types/node": "^20.11.5",
    "shx": "^0.3.4",
    "typescript": "^5.3.3"
  }
}
