{
  "services": {
    "hermes-db": {
      "image": "ghcr.io/north-sea/hermes-db-mcp",
      "context": "packages/hermes-db",
      "dockerfile": "packages/hermes-db/Dockerfile",
      "platforms": ["linux/amd64"],
      "test": {
        "workingDirectory": "packages/hermes-db",
        "command": "python -m pip install uv\nuv run pytest tests -q"
      },
      "deploy": {
        "composeProjectDir": "/vol1/1000/Docker/hermes-db-mcp",
        "composeFile": "docker-compose.yml",
        "composeService": "hermes-db-mcp",
        "containerName": "hermes-db-mcp",
        "requiredEnv": [
          "PG_DSN"
        ],
        "migration": {
          "entrypoint": "alembic",
          "command": "upgrade head"
        },
        "health": {
          "type": "mcp-health",
          "url": "http://127.0.0.1:8765/mcp",
          "tokenEnv": "API_TOKEN",
          "capabilities": [
            "topic_bucket",
            "topic_revisit_of",
            "list_revisit_chain",
            "workflow_runs",
            "workflow_artifacts",
            "wechat_publication_ledger",
            "wechat_analytics_ingestion",
            "wechat_retrospective_topic_optimizer",
            "agent_self_evolution_foundation",
            "topic_candidates",
            "topic_plans",
            "topic_plan_feedback"
          ]
        }
      }
    },
    "wechat-draft": {
      "image": "ghcr.io/north-sea/wechat-draft-mcp",
      "context": ".",
      "dockerfile": "packages/wechat-draft/Dockerfile",
      "platforms": ["linux/amd64"],
      "test": {
        "workingDirectory": ".",
        "command": "corepack enable\ncorepack prepare pnpm@8.6.10 --activate\npnpm install --frozen-lockfile\npnpm --filter @mcps/wechat-draft build\npnpm --filter @mcps/wechat-draft test"
      },
      "deploy": {
        "composeProjectDir": "/vol1/1000/Docker/wechat-draft-mcp",
        "composeFile": "docker-compose.yml",
        "composeService": "wechat-draft-mcp",
      "containerName": "wechat-draft-mcp",
      "requiredEnv": [
        "AUTH_TOKEN",
        "HERMES_DB_BASE_URL",
        "HERMES_DB_AUTH_TOKEN",
        "WECHAT_ADAPTER_BASE_URL",
          "WECHAT_ADAPTER_AUTH_TOKEN"
        ],
      "health": {
        "type": "http-health",
        "url": "http://127.0.0.1:3012/health"
      }
    }
  }
  }
}
